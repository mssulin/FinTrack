@model WebApp.ViewModels.DashboardViewModel

<div class="card relative flex flex-col justify-center p-6">

   <!-- Button -->
   <button class="absolute top-3 right-3 inline-flex items-center gap-1
                     px-2 py-1 text-[10px] font-medium
                     text-sky-300 bg-sky-500/10 ring-1 ring-sky-500/>30 rounded-md
                     shadow-sm hover:bg-sky-500/>20 hover:ring-sky-400/>40
                     active:scale-[.98] transition
                     sm:px-3 sm:py-1.5 sm:text-xs
                     md:px-4 md:py-2 md:text-sm" data-modal-target="add-saving-modal">
      <span class="material-icons text-[14px] sm:text-[16px] md:text-[18px]">add</span>
      <span class="hidden sm:inline">Lägg till sparande</span>
   </button>

   <!-- Header -->
   <div class="flex flex-col items-start">
      <h3 class="text-white/95 font-semibold flex items-start gap-2 text-base sm:text-lg">
         <span class="text-[18px] sm:text-[20px] select-none">📉</span>
         Månadens sparande
      </h3>
      <div class="h-[2px] w-20 sm:w-28 mt-2 bg-gradient-to-r from-sky-300 to-green-400 rounded-full"></div>
   </div>

   <!-- Body -->
   <div class="flex flex-col items-center justify-center mt-6 text-center">
      <h3 class="text-sm text-grey-400">Du har sparat</h3>

      <div class="mt-2 text-xl font-bold text-emerald-300
                  bg-emerald-500/10 ring-1 ring-emerald-400/30 rounded-lg px-4 py-2">
         <p class="text-lg font-bold text-white mt-1">@Model.SavingPercent %</p>
      </div>

      <p class="text-sm text-gray-400 mt-2">av din inkomst den här månaden</p>
   </div>
</div>