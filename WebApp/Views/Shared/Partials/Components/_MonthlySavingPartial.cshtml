@model WebApp.ViewModels.DashboardViewModel

<div class="group card relative flex flex-col justify-center p-6">
   <button data-modal-target="add-saving-modal"
           class="absolute top-3 right-3 inline-flex items-center gap-1
                   px-2 py-1 text-[11px] font-medium
                   text-sky-300 bg-sky-500/10 ring-1 ring-sky-500/30 rounded-md
                   shadow-sm transition duration-200
                   hover:bg-sky-500/20 hover:ring-sky-400/40
                   active:scale-[.98]">
      <span class="material-icons text-[14px]">add</span>
   </button>
   
   <div class="flex flex-col items-start">
      <h3 class="dashboard-card-title">
         <span class="dashboard-card-icon">💰</span>
         Månadens sparande
      </h3>
      <div class="card-accent-line from-sky-300 to-green-400"></div>
   </div>
   
   <div class="flex flex-col items-center justify-center mt-6 text-center">
      <h3 class="text-sm text-grey-400">Du har sparat</h3>

      <div class="mt-2 text-xl font-bold text-emerald-300
                  bg-emerald-500/10 ring-1 ring-emerald-400/30 rounded-lg px-4 py-2">
         <p class="text-lg font-bold text-white mt-1">@Model.SavingPercent %</p>
      </div>

      <p class="text-sm text-gray-400 mt-2">av din inkomst den här månaden</p>
   </div>
</div>