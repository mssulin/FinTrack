
    <!-- Inkomster-->
    <div class="group card summary-card">
        <button id="add-income-btn"
                data-modal-target="add-income-modal"
                class="summary-action-btn summary-action-btn--income">
            <span class="material-icons text-[14px]">add</span>
        </button>

        <span class="summary-badge
             bg-emerald-500/10 text-emerald-300 ring-1 ring-emerald-500/30">
        <span class="summary-dot bg-emerald-400"></span>
        Inkomst
        </span>
        <p class="summary-value">+@Model.TotalIncome.ToString("N0") kr</p>
    </div>

    <!-- Utgifter -->
    <div class="group card summary-card">
        <button id="add-expense-btn"
                data-modal-target="add-expense-modal"
                class="summary-action-btn summary-action-btn--expense">
            <span class="material-icons text-[14px]">add</span>
        </button>
        <span class="summary-badge
             bg-rose-500/10 text-rose-300 ring-1 ring-rose-500/30">
        <span class="summary-dot bg-rose-400"></span>
        Utgifter
        </span>
    <p class="summary-value">-@Model.TotalExpenses.ToString("N0") kr</p>
    </div>


    <!-- Prenumerationer -->
    <div class="card summary-card">
    <span class="summary-badge
             bg-amber-500/10 text-amber-300 ring-1 ring-amber-500/30">
    <span class="summary-dot bg-amber-400"></span>
    Prenumerationer
    </span>
        <p class="summary-value">@Model.TotalSubscriptions.ToString("N0") kr</p>
    </div>

    <!-- På kontot -->
    <div class="card summary-card">
    <span class="summary-badge
             bg-sky-500/10 text-sky-300 ring-1 ring-sky-500/30">
    <span class="summary-dot bg-sky-400"></span>
    På kontot
    </span>
        <p class="summary-value">@Model.AvailableMoney.ToString("N0") kr</p>
    </div>
    