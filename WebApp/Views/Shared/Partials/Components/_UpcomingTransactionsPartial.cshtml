@model IEnumerable<WebApp.ViewModels.SubscriptionViewModel>

<div class="flex">
<div class="card w-full h-full flex flex-col p-4 sm:p-5 lg:p-6">

  <!-- Header -->
  <div class="mb-4 sm:mb-5">
    <h3 class="text-white/95 fond-semibold flex items-center gap-2 text-base sm:text-lg">
      Kommande utgifter (14 dagar)
    </h3>
    <div class="h-[2px] w-20 sm:w-28 mt-2 bg-gradient-to-r from-rose-400 to-amber-400 rounded-full">
    </div>
        
    <div class="flex flex-col divide-y divide-white/5">
      @if (!Model.Any())
      {
        <div class="py-8 text-center text-sm sm:text-base text-white/60">
          Inga kommande utgifter inom 14 dagar
        </div>
        
      }
      else
      {
        @foreach (var sub in Model)
        {
          var daysLeft = (sub.NextPaymentDate - DateTime.Today).Days;
          var daysText = daysLeft == 0 ? "Idag" : $"{daysLeft} dagar kvar";

          var badgeClass = daysLeft <= 0
            ? "bg-rose-500/15 text-rose-300 ring-rose-400/30"
            : (daysLeft <= 3
              ? "bg-amber-500/10 text-amber-300 ring-amber-400/30"
              : "bg-white/10 text-white/70 ring-white/10");

          <div class="py-3 sm:py-4">
            <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] items-center gap-3 md:gap-4">

              <!-- Titel -->
              <div class="flex items-center gap-3 min-w-0">
                <img src="@sub.ImageUrl" alt="@sub.Name"
                     class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg object-cover ring-1 ring-white/10" />
                <p class="text-white/90 truncate text-sm sm:text-base max-w-[60vw] sm:max-w-[420px]">
                  @sub.Name
                </p>
              </div>

              <!-- Days-left -->
              <div class="flex items-center justify-between md:justify-end gap-3">
                <span class="@($"inline-flex items-center gap-2 text-[11px] sm:text-xs font-medium px-2.5 py-1 rounded-md ring-1 {badgeClass}")">
                  <span class="w-1.5 h-1.5 rounded-full
                    @(daysLeft <= 0 ? "bg-rose-400" : (daysLeft <= 3 ? "bg-amber-400" : "bg-white/40"))"></span>
                  @daysText
                </span>

                <!-- Paid button -->
                <form asp-controller="Subscription" asp-action="Paid" asp-route-id="@sub.Id" method="post">
                  @Html.AntiForgeryToken()
                  <button type="submit"
                          class="inline-flex items-center gap-1
                                 px-2 py-[3px] text-[11px] sm:text-xs font-medium
                                 text-rose-300 bg-rose-500/10 ring-1 ring-rose-500/30 rounded-md
                                 hover:bg-rose-500/20 hover:ring-rose-400/40
                                 active:scale-[.98] transition">
                    ✔ Betald
                  </button>
                </form>
              </div>

            </div>
          </div>
        }
      }
    </div>

  </div>
</div>
</div>