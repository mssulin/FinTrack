@model IEnumerable<WebApp.ViewModels.SubscriptionViewModel>

<div class="py-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
        @foreach (var sub in Model)
        {
            <div class="group list-card">
                
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="list-card-icon overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(sub.ImageUrl))
                            {
                                <img src="@sub.ImageUrl" class="h-10 w-10 object-contain" alt="@sub.Name" />
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">N/A</span>
                            }
                        </div>

                        <div class="min-w-0">
                            <h3 class="truncate text-sm font-semibold text-white">@sub.Name</h3>
                        </div>
                    </div>
                    
                    <span class="list-card-tag">
                        @sub.Category
                    </span>
                </div>
                
                <div class="mt-5">
                    <p class="text-xs text-gray-400">Kostnad</p>
                    <p class="mt-1 text-lg font-semibold text-white">
                        @sub.Amount.ToString("0") kr
                        <span class="text-sm font-medium text-gray-400">/ @sub.Frequency</span>
                    </p>
                </div>
                
                <div class="mt-4 list-card-info">
                    <p class="text-xs text-gray-400">Nästa betalning</p>
                    <p class="mt-1 text-sm font-medium text-gray-200">
                        @sub.NextPaymentDate.ToString("yyyy-MM-dd")
                    </p>
                </div>
                
                <div class="list-card-actions">
                    <button type="button"
                            onclick="document.getElementById('edit-subscription-@sub.Id').classList.remove('hidden')"
                            class="list-card-btn list-card-btn--edit">
                        Redigera
                    </button>

                    @await Html.PartialAsync("Partials/Modals/_EditSubscriptionModal", sub)

                    <form asp-controller="Subscription" asp-action="Delete" method="post" class="shrink-0">
                        <input type="hidden" name="id" value="@sub.Id" />
                        <button type="submit"
                                class="list-card-btn list-card-btn--delete">
                            Radera
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>