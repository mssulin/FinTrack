@model IEnumerable<WebApp.ViewModels.SubscriptionViewModel>

<div class="py-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
        @foreach (var sub in Model)
        {
            <div class="group rounded-2xl border border-white/10 bg-white/[0.04] p-5 shadow-sm transition hover:border-white/15 hover:bg-white/[0.06]">
                
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="h-12 w-12 rounded-xl bg-white/5 ring-1 ring-white/10 overflow-hidden flex items-center justify-center">
                            @if (!string.IsNullOrWhiteSpace(sub.ImageUrl))
                            {
                                <img src="@sub.ImageUrl" class="h-10 w-10 object-contain" alt="@sub.Name" />
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">N/A</span>
                            }
                        </div>

                        <div class="min-w-0">
                            <h3 class="truncate text-sm font-semibold text-white">@sub.Name</h3>
                        </div>
                    </div>
                    
                    <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-2 py-1 text-[11px] text-gray-300">
                        @sub.Category
                    </span>
                </div>
                
                <div class="mt-5">
                    <p class="text-xs text-gray-400">Kostnad</p>
                    <p class="mt-1 text-lg font-semibold text-white">
                        @sub.Amount.ToString("0") kr
                        <span class="text-sm font-medium text-gray-400">/ @sub.Frequency</span>
                    </p>
                </div>
                
                <div class="mt-4 rounded-xl border border-white/10 bg-black/20 p-3">
                    <p class="text-xs text-gray-400">Nästa betalning</p>
                    <p class="mt-1 text-sm font-medium text-gray-200">
                        @sub.NextPaymentDate.ToString("yyyy-MM-dd")
                    </p>
                </div>
                
                <div class="mt-5 flex items-center justify-end gap-2
                        opacity-100 md:opacity-0
                        transition duration-200
                            group-hover:opacity-100">
                    <button type="button"
                            class="inline-flex items-center justify-center rounded-md border border-white/15 bg-white/5 px-3 py-2 text-xs font-medium text-gray-300 transition hover:bg-white/10 hover:text-white">
                        Redigera
                    </button>

                    <form asp-controller="Subscription" asp-action="Delete" method="post" class="shrink-0">
                        <input type="hidden" name="id" value="@sub.Id" />
                        <button type="submit"
                                class="inline-flex items-center justify-center rounded-md border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-xs font-medium text-rose-200 transition hover:bg-rose-500/15 hover:border-rose-500/40">
                            Radera
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>