@using WebApp.Helpers
@model IEnumerable<WebApp.ViewModels.SavingViewModel>

@{
    var items = Model?.ToList() ?? new List<WebApp.ViewModels.SavingViewModel>();
}

<div class="py-2">
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        @foreach (var saving in items)
        {
            var left = saving.TargetAmount - saving.CurrentAmount;
            if (left < 0) left = 0;

            <div class="group list-card">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="list-card-icon text-xl">
                            @EmojiHelper.GetEmoji(saving.Title)
                        </div>

                        <div class="min-w-0">
                            <h3 class="truncate text-sm font-semibold text-white">@saving.Title</h3>
                            <p class="mt-0.5 text-xs text-gray-400">
                                Mål: @saving.TargetAmount.ToString("N0") kr
                            </p>
                        </div>
                    </div>

                    <span class="list-card-tag">
                        @saving.ProgressPercent%
                    </span>
                </div>
                
                <div class="mt-5">
                    <div class="flex items-center justify-between text-xs">
                        <p class="text-gray-400">Progress</p>
                        <p class="text-gray-300">
                            @saving.CurrentAmount.ToString("N0") / @saving.TargetAmount.ToString("N0") kr
                        </p>
                    </div>

                    <div class="mt-2 h-2 w-full rounded-full bg-white/10 ring-1 ring-white/10 overflow-hidden">
                        <div class="h-full rounded-full bg-gradient-to-r from-sky-400 via-emerald-400 to-purple-400
                                    transition-[width] duration-500 ease-out"
                             style="width:@saving.ProgressPercent%"></div>
                    </div>
                </div>
                
                <div class="mt-4 grid grid-cols-2 gap-3">
                    <div class="list-card-info">
                        <p class="text-[11px] font-semibold text-gray-300">Sparat</p>
                        <p class="mt-1 text-sm font-semibold text-white">@saving.CurrentAmount.ToString("N0") kr</p>
                    </div>

                    <div class="rounded-xl border border-white/10 bg-black/20 p-3">
                        <p class="text-[11px] font-semibold text-gray-300">Kvar</p>
                        <p class="mt-1 text-sm font-semibold text-white">@left.ToString("N0") kr</p>
                    </div>
                </div>
                
            <div class="list-card-actions">
                
    <div class="text-xs text-gray-400">
        @if (saving.ProgressPercent >= 100)
        {
            <span class="inline-flex items-center gap-2 rounded-full
                         border border-emerald-500/30 bg-emerald-500/10
                         px-2 py-1 text-[11px] text-emerald-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                Mål uppnått
            </span>
        }
        else
        {
            <span class="inline-flex items-center gap-2 rounded-full
                         border border-white/10 bg-white/5
                         px-2 py-1 text-[11px] text-gray-300">
                <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
                Pågående
            </span>
        }
    </div>
    
    <div class="flex items-center gap-2 shrink-0">
        
        @await Html.PartialAsync("Partials/Modals/_SavingHistoryModal", saving.Id)
        
        <button type="button"
                onclick="document.getElementById('edit-saving-@saving.Id').classList.remove('hidden')"
                class="list-card-btn list-card-btn--edit">
            Redigera
        </button>
        
        @await Html.PartialAsync("Partials/Modals/_EditSavingModal", saving)
        
        <form asp-controller="Saving" asp-action="Delete" method="post"
              onsubmit="return confirm('Är du säker på att du vill radera detta sparmål?');">
            <input type="hidden" name="id" value="@saving.Id" />
            <button type="submit"
                    class="list-card-btn list-card-btn--delete">
                Radera
            </button>
        </form>
    </div>
        </div>

            </div>
        }
    </div>
</div>