@model List<WebApp.ViewModels.ExpenseViewModel>

<div class="card w-full h-full p-4 sm:p-5 lg:p-6">
    
    <div class="mb-4 sm:mb-5">
        <h3 class="text-white/95 font-semibold flex items-center gap-2 text-base sm:text-lg">
            <span class="dashboard-card-title">📉</span>
            Totala utgifter
        </h3>
        <div class="card-accent-line from-purple-400 to-pink-400"></div>
    </div>
    
    <div class="relative w-full h-[220px] sm:h-[260px] lg:-[320px]">
        <canvas id="expenseChart"
                class="absolute inset-0"
                data-categories='@System.Text.Json.JsonSerializer.Serialize(Model.Select(e => e.Category).Distinct())'
                data-amounts='@System.Text.Json.JsonSerializer.Serialize(Model.GroupBy(e => e.Category).Select(g => g.Sum(x => x.Amount)))'>
        </canvas>
    </div>
</div>