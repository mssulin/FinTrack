@model WebApp.ViewModels.SignUpViewModel

<div class="auth-card">
    <div class="auth-header">
        <h3 class="auth-title">Skapa konto</h3>
    </div>
    
    <form asp-controller="Auth" asp-action="SignUp" method="post" novalidate class="auth-form">
        @Html.AntiForgeryToken()
        
        <div class="form-field">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="modal-input" />
            <span asp-validation-for="FirstName" class="field-error"></span>
        </div>
        
        <div class="form-field">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="modal-input" />
            <span asp-validation-for="LastName" class="field-error"></span>
        </div>
        
        <div class="form-field">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="modal-input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="modal-input" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        
        <div class="form-field">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="modal-input" type="password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <button type="submit" class="modal-submit">Skapa ett konto</button>
    </form>

    <div class="auth-footer">
        Redan registrerad?
        <a asp-controller="Auth" asp-action="SignIn" class="auth-btn">Logga in</a>
    </div>
</div>