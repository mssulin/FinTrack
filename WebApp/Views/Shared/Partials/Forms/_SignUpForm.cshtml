@model WebApp.ViewModels.SignUpViewModel

<div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/[0.04] p-6">
    <div class="text-center mb-6">
        <h3 class="text-xl font-semibold text-white">Skapa ett konto</h3>
    </div>
    
    <form asp-controller="Auth" asp-action="SignUp" method="post" novalidate class="flex flex-col gap-4">
        @Html.AntiForgeryToken()
        
        <div class="flex flex-col gap-1">
            <label asp-for="FirstName" class="text-sm text-gray-300"></label>
            <input asp-for="FirstName" class="modal-input" />
            <span asp-validation-for="FirstName" class="text-xs text-rose-300"></span>
        </div>
        
        <div class="flex flex-col gap-1">
            <label asp-for="LastName" class="text-sm text-gray-300"></label>
            <input asp-for="LastName" class="modal-input" />
            <span asp-validation-for="LastName" class="text-xs text-rose-300"></span>
        </div>
        
        <div class="flex flex-col gap-1">
            <label asp-for="Email" class="text-sm text-gray-300"></label>
            <input asp-for="Email" class="modal-input" />
            <span asp-validation-for="Email" class="text-xs text-rose-300"></span>
        </div>

        <div class="flex flex-col gap-1">
            <label asp-for="Password" class="text-sm text-gray-300"></label>
            <input asp-for="Password" type="password" class="modal-input" />
            <span asp-validation-for="Password" class="text-xs text-rose-300"></span>
        </div>
        
        <div class="flex flex-col gap-1">
            <label asp-for="ConfirmPassword" class="text-sm text-gray-300"></label>
            <input asp-for="ConfirmPassword" class="modal-input" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-300"></span>
        </div>
        
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-300"></div>

        <button type="submit" class="modal-submit">Skapa ett konto</button>
    </form>

    <div class="mt-6 text-center text-xs text-gray-400">
        Redan registrerad?
        <a asp-controller="Auth" asp-action="SignIn" class="text-emerald-400 hover:underline">Logga in</a>
    </div>
</div>