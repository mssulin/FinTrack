@model WebApp.ViewModels.SignInViewModel

<div class="auth-card">
    <div class="auth-header">
        <h3 class="auth-title">Logga in</h3>
    </div>
    
    <form asp-controller="Auth" asp-action="SignIn" method="post" novalidate class="auth-form">
        @Html.AntiForgeryToken()
        
        <div class="form-field">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="modal-input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="modal-input" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <button type="submit" class="modal-submit">Logga in</button>
    </form>

    <div class="auth-footer">
        Inte registrerad?
        <a asp-controller="Auth" asp-action="Signup" class="auth-btn">Skapa ett konto</a>
    </div>
</div>