@model WebApp.ViewModels.SignInViewModel

<div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/[0.04] p-6">
    <div class="text-center mb-6">
        <h3 class="text-xl font-semibold text-white">Logga in</h3>
    </div>
    
    <form asp-controller="Auth" asp-action="SignIn" method="post" novalidate class="flex flex-col gap-4">
        @Html.AntiForgeryToken()
        
        <div class="form-field">
            <label asp-for="Email" class="text-sm text-gray-300"></label>
            <input asp-for="Email" class="modal-input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Password" class="text-sm text-gray-300"></label>
            <input asp-for="Password" type="password" class="modal-input" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <button type="submit" class="modal-submit">Logga in</button>
    </form>

    <div class="mt-6 text-center text-xs text-gray-400">
        Inte registrerad?
        <a asp-controller="Auth" asp-action="Signup" class="text-emerald-400 hover:underline">Skapa ett konto</a>
    </div>
</div>