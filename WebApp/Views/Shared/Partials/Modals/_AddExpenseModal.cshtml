@model WebApp.ViewModels.DashboardViewModel

<div id="add-expense-modal" class="modal">
    
    <div class="modal-card relative">
        <div class="modal-header">
            <h3 class="modal-title">Lägg till utgift</h3>
            <button type="button" class="modal-close">x</button>
        </div>

        <form asp-controller="Expense" asp-action="AddExpense" method="post" class="modal-form">
            
            @await Html.PartialAsync("Partials/Components/_ModalDropdown",
                new WebApp.ViewModels.ModalDropdownViewModel
                {
                    Label = "Kategori",
                    Name = "Category",
                    Placeholder = "Välj kategori",
                    Items = Model.ExpenseCategories
                })

            <div>
                <label for="amount" class="modal-label">Summa</label>
                <input type="number" step="0.01" id="amount" name="Amount" required class="modal-input"/>
            </div>

            <button type="submit" class="modal-submit">Lägg till</button>
        </form>
    </div>
</div>