@model WebApp.ViewModels.DashboardViewModel

<div id="add-expense-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Lägg till utgift</h3>
            <span class="close"></span>
        </div>

        <form asp-controller="Expense" asp-action="Add" method="post">
            <div class="form">
                <label for="category">Kategori</label>
                <select id="category" name="Category" required>
                    @foreach (var category in Model.ExpenseCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>

            <div class="form">
                <label for="amount">Summa</label>
                <input type="number" step="0.01" id="amount" name="Amount" required />
            </div>

            <button type="submit" class="btn modal-button">Lägg till</button>
        </form>
    </div>
</div>