@model WebApp.ViewModels.DashboardViewModel

<div id="add-income-modal" class="modal">

    <div class="modal-card relative">
        <div class="modal-header">
            <h3 class="modal-title">Lägg till inkomst</h3>
            <button type="button" class="modal-close">x</button>
        </div>

        <form asp-controller="Income" asp-action="AddIncome" method="post" class="modal-form">
            
            @await Html.PartialAsync("Partials/Components/_ModalDropdown", new WebApp.ViewModels.ModalDropdownViewModel
            {
                Label = "Inkomstkälla",
                Name = "NewIncome.Source",
                Placeholder = "Välj inkomstkälla",
                Value = Model.NewIncome?.Source,
                Items = Model.IncomeSources
            })

            <div>
                <label class="modal-label">Summa</label>
                <input asp-for="NewIncome.Amount"
                       type="number"
                       required
                       class="modal-input"/>
            </div>
            <button type="submit"
                    class="modal-submit">
                Lägg till
            </button>
        </form>
    </div>
</div>