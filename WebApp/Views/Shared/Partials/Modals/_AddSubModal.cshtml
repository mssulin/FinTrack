<div id="sub-modal" class="hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Lägg till prenumeration</h3>
        </div>

        <form asp-controller="Subscription" asp-action="Add" method="post" enctype="multipart/form-data">

            <div class="subscription-image">
                <div class="image-preview-container">
                    <img id="subImagePreview" class="image-preview hide" alt="Preview" />
                    <div class="image-preview-icon-container">
                        <i class="fa-duotone fa-solid fa-camera"></i>
                    </div>
                </div>
                <input type="file" id="image" name="Image" accept="image/*" />
            </div>

            <div>
                <label for="name">Namn</label>
                <input type="text" id="name" name="Name" required />
            </div>

            <div>
                <label for="amount">Summa</label>
                <input type="number" id="amount" name="Amount" required />
            </div>
            <div>
                <label for="category">Kategori</label>
                <input type="text" id="category" name="Category" required />
            </div>
            <div>
                <label for="lastPayment">Senaste betalning</label>
                <input type="date" id="lastPayment" name="LastPaymentDate" class="form-control" required />
            </div>

            <div>
                <label for="frequency">Hur ofta ska det betalas?</label>
                <select id="frequency" name="Frequency">
                    <option value="Månad">1 gång / månad</option>
                    <option value="Kvartal">1 gång / kvartal</option>
                    <option value="År">1 gång / år</option>
                </select>
            </div>

            <button type="submit" class="btn modal-button">Lägg till</button>
        </form>
    </div>
</div>

<script>
    const imageInput = document.getElementById("image");
    const preview = document.getElementById("subImagePreview");

    imageInput.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove("hide");
            };
            reader.readAsDataURL(file);
        }
    });
</script>