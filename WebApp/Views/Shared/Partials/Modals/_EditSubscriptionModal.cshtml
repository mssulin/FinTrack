@using System.Globalization
@model WebApp.ViewModels.SubscriptionViewModel

<div id="edit-subscription-@Model.Id"
     class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center px-4">

    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#111827] p-6 shadow-xl">

        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">Redigera prenumeration</h2>

            <button type="button"
                    onclick="document.getElementById('edit-subscription-@Model.Id').classList.add('hidden')"
                    class="text-gray-400 hover:text-white">
                ✕
            </button>
        </div>

        <form asp-controller="Subscription"
              asp-action="Update"
              method="post"
              class="space-y-4">

            @Html.AntiForgeryToken()

            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />
            <input type="hidden" name="IsPaid" value="@Model.IsPaid.ToString().ToLower()" />

            <div>
                <label class="text-xs font-medium text-gray-300">Namn</label>
                <input name="Name"
                       value="@Model.Name"
                       required
                       autocomplete="off"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Kostnad</label>
                <input name="Amount"
                       type="number"
                       step="0.01"
                       min="0"
                       value="@Model.Amount.ToString(CultureInfo.InvariantCulture)"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Kategori</label>
                <input name="Category"
                       value="@Model.Category"
                       required
                       autocomplete="off"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Frekvens</label>
                <select name="Frequency"
                        class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white">
                    <option value="Vecka" selected="@(Model.Frequency == "Vecka")">Vecka</option>
                    <option value="Månad" selected="@(Model.Frequency == "Månad")">Månad</option>
                    <option value="Kvartal" selected="@(Model.Frequency == "Kvartal")">Kvartal</option>
                    <option value="År" selected="@(Model.Frequency == "År")">År</option>
                </select>
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Senaste betalning</label>
                <input name="LastPaymentDate"
                       type="date"
                       value="@Model.LastPaymentDate.ToString("yyyy-MM-dd")"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Nästa betalning</label>
                <input name="NextPaymentDate"
                       type="date"
                       value="@Model.NextPaymentDate.ToString("yyyy-MM-dd")"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div class="flex justify-end gap-2 pt-3">
                <button type="button"
                        onclick="document.getElementById('edit-subscription-@Model.Id').classList.add('hidden')"
                        class="rounded-md border border-white/10 bg-white/5 px-4 py-2 text-xs text-gray-300 hover:bg-white/10">
                    Avbryt
                </button>

                <button type="submit"
                        class="rounded-md bg-sky-500 px-4 py-2 text-xs font-semibold text-white hover:bg-sky-400">
                    Spara
                </button>
            </div>
        </form>
    </div>
</div>