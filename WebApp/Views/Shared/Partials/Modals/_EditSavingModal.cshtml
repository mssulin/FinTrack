@model WebApp.ViewModels.SavingViewModel

<div id="edit-saving-@Model.Id"
     class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center px-4">

    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#111827] p-6 shadow-xl">

        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">
                Redigera sparmål
            </h2>

            <button type="button"
                    onclick="document.getElementById('edit-saving-@Model.Id').classList.add('hidden')"
                    class="text-gray-400 hover:text-white">
                ✕
            </button>
        </div>

        <form asp-controller="Saving"
              asp-action="Update"
              method="post"
              class="space-y-4">

            <input type="hidden" name="Id" value="@Model.Id" />

            <div>
                <label class="text-xs font-medium text-gray-300">Titel</label>
                <input name="Title"
                       value="@Model.Title"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Sparat belopp</label>
                <input name="CurrentAmount"
                       type="number"
                       step="0.01"
                       value="@Model.CurrentAmount"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div>
                <label class="text-xs font-medium text-gray-300">Målbelopp</label>
                <input name="TargetAmount"
                       type="number"
                       step="0.01"
                       value="@Model.TargetAmount"
                       class="mt-1 w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-white" />
            </div>

            <div class="flex justify-end gap-2 pt-3">
                <button type="button"
                        onclick="document.getElementById('edit-saving-@Model.Id').classList.add('hidden')"
                        class="rounded-md border border-white/10 bg-white/5 px-4 py-2 text-xs text-gray-300 hover:bg-white/10">
                    Avbryt
                </button>

                <button type="submit"
                        class="rounded-md bg-sky-500 px-4 py-2 text-xs font-semibold text-white hover:bg-sky-400">
                    Spara
                </button>
            </div>
        </form>
    </div>
</div>