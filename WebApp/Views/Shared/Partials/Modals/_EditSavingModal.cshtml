@model WebApp.ViewModels.SavingViewModel

<div id="edit-saving-@Model.Id"
     class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center px-4">

    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#111827] p-6 shadow-xl">

        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">
                Redigera sparmål
            </h2>
        </div>

        <form asp-controller="Saving"
              asp-action="Update"
              method="post"
              class="space-y-4">

            <input type="hidden" name="Id" value="@Model.Id" />

            <div>
                <label class="modal-label">Titel</label>
                <input name="Title"
                       value="@Model.Title"
                       class="modal-input--edit" />
            </div>

            <div>
                <label class="modal-label">Sparat belopp</label>
                <input name="CurrentAmount"
                       type="number"
                       step="0.01"
                       min="0"
                       value="@Model.CurrentAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       class="modal-input--edit" />
            </div>

            <div>
                <label class="modal-label">Målbelopp</label>
                <input name="TargetAmount"
                       type="number"
                       step="0.01"
                       min="0"
                       value="@Model.TargetAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       class="modal-input--edit" />
            </div>

            <div class="flex justify-end gap-2 pt-3">
                <button type="button"
                        onclick="document.getElementById('edit-saving-@Model.Id').classList.add('hidden')"
                        class="modal-btn--cancel">
                    Avbryt
                </button>

                <button type="submit"
                        class="modal-btn--save">
                    Spara
                </button>
            </div>
        </form>
    </div>
</div>