@model WebApp.ViewModels.AddDepositViewModel

<div id="deposit-modal-@Model.SavingId" class="hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Lägg till insättning</h3>
            <span class="close" data-close></span>
        </div>
        <form asp-controller="Savings" asp-action="AddDeposit" method="post">
            <input type="hidden" name="SavingId" value="@Model.SavingId" />

            <div class="form">
                <label for="amount-@Model.SavingId">Belopp</label>
                <input type="number" step="0.01" id="amount-@Model.SavingId" name="Amount" required />
            </div>

            <button type="submit"
                    class="btn modal-button"
                    formaction="@Url.Action("AddDeposit","Savings")">
                Lägg till insättning
            </button>

            <button type="submit"
                    class="btn modal-button"
                    formaction="@Url.Action("AddInterest","Savings")">
                Lägg till ränta
            </button>
            
        </form>
    </div>
</div>