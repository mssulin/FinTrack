
<div id="add-saving-modal" class="hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Nytt sparmål</h3>
            <span class="close"></span>
        </div>

        <form asp-controller="Savings" asp-action="AddDeposit" method="post">
            <div class="form">
                <label for="savingId">Välj sparmål</label>
                <select id="savingId" name="SavingId" required>
                    @foreach (var saving in Model)
                    {
                        <option value="@saving.Id">@saving.Title (Nuvarande: @saving.CurrentAmount kr)</option>
                    }
                </select>
            </div>

            <div class="form">
                <label for="amount">Belopp att spara</label>
                <input type="number" step="0.01" id="amount" name="Amount" required />
            </div>

            <button type="submit" class="btn modal-button">Spara</button>
        </form>
    </div>
</div>