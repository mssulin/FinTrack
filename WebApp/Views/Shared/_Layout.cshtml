<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>FinTrack – @ViewData["Title"]</title>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
  
</head>
<body class="m-0 text-[16px] text-gray-200 font-[var(--font-sans)] not-italic bg-[#0F111A] font-medium pb-[calc(76px+env(safe-area-inset-bottom))]">

  <div id="layout" class="min-h-dvh grid grid-cols-1 grid-rows-[auto_1fr_auto] gap-4
                          lg:grid-cols-[250px_minmax(0,1fr)] lg:grid-rows-[1fr_auto] lg:gap-4 lg:p-4">
    
    @await Html.PartialAsync("Partials/Components/Navbar/_NavbarPartial")

    <!-- Main -->
    <main class="min-w-0 lg:col-start-2">
      @RenderBody()
    </main>

    <!-- Footer-->
    <footer class="lg:col-span-2">
      @await Html.PartialAsync("Partials/Components/_FooterPartial")
    </footer>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="~/js/chart.js" asp-append-version="true"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  <script src="~/js/modal.js" asp-append-version="true"></script>
  <script src="~/js/dropdown.js" asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)
  @await RenderSectionAsync("Modals", required: false)
</body>
</html>