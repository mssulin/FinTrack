@model IEnumerable<WebApp.ViewModels.SubscriptionViewModel>

@{
    ViewData["Title"] = "Prenumerationer";
    var total = Model?.Sum(x => x.Amount) ?? 0m;
    var count = Model?.Count() ?? 0;
    
    var today = DateTime.Today;
    var soon = Model?
        .Where(x => x.NextPaymentDate.Date >= today && x.NextPaymentDate.Date <= today.AddDays(14))
        .Count() ?? 0;
}
    
    <div class="page-header">
        <div>

            <h1 class="page-title">Prenumerationer</h1>
            <p class="page-description">
                Håll koll på dina återkommande kostnader och nästa betalning.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button id="add-sub" data-modal-target="sub-modal"
                    class="primary-action-btn">
                <span class="text-lg leading-none">+</span>
                <span>Ny prenumeration</span>
            </button>
        </div>
    </div>
    
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3 px-6 md:px-0">
        <div class="stats-card">
            <p class="stats-title">Antal prenumerationer</p>
            <p class="stats-value">@count</p>
        </div>

        <div class="stats-card">
            <p class="stats-title">Totalt per månad</p>
            <p class="stats-value">@total.ToString("N0") kr</p>
            <p class="stats-description">Summerar alla prenumerationer</p>
        </div>

        <div class="stats-card">
            <p class="stats-title">Kommande (14 dagar)</p>
            <p class="stats-value">@soon</p>
            <p class="stats-description">Nästa betalning inom 2 veckor</p>
        </div>
    </div>
    
    <div class="section-overview">
        <div class="flex items-center justify-between gap-3">
            <p class="text-lg font-semibold text-white">Översikt</p>
        </div>

        <div class="mt-4">
            @if (Model == null || !Model.Any())
            {
                <div class="rounded-xl border border-white/10 bg-black/20 p-6 text-center">
                    <p class="text-sm font-medium text-white">Inga prenumerationer än</p>
                    <p class="mt-1 text-sm text-gray-400">Lägg till din första för att se översikten här.</p>

                    <button id="add-sub" data-modal-target="sub-modal"
                            class="primary-action-btn">
                        <span class="text-lg leading-none">+</span>
                        <span>Lägg till prenumeration</span>
                    </button>
                </div>
            }
            else
            {
                @await Html.PartialAsync("Partials/Components/Cards/_SubCard", Model)
            }
        </div>
    </div>

@await Html.PartialAsync("Partials/Modals/_AddSubmodal")