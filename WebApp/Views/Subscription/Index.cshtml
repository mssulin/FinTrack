@model IEnumerable<WebApp.ViewModels.SubscriptionViewModel>

@{
    var total = Model?.Sum(x => x.Amount) ?? 0m;
    var count = Model?.Count() ?? 0;
    
    var today = DateTime.Today;
    var soon = Model?
        .Where(x => x.NextPaymentDate.Date >= today && x.NextPaymentDate.Date <= today.AddDays(14))
        .Count() ?? 0;
}

<div class="space-y-6">
    
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>

            <h1 class="mt-3 text-2xl font-semibold text-white">Prenumerationer</h1>
            <p class="mt-1 text-sm text-gray-400">
                Håll koll på dina återkommande kostnader och nästa betalning.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button id="add-sub" data-modal-target="sub-modal"
                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white
                           transition hover:bg-emerald-500 active:scale-[.99]">
                <span class="text-lg leading-none">+</span>
                <span>Lägg till</span>
            </button>
        </div>
    </div>
    
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3 px-6 md:px-0">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center md:text-left">
            <p class="text-xs font-semibold text-gray-300">Antal prenumerationer</p>
            <p class="mt-2 text-xl font-bold text-white">@count</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center md:text-left">
            <p class="text-xs font-semibold text-gray-300">Totalt per månad</p>
            <p class="mt-2 text-xl font-bold text-white">@total.ToString("N0") kr</p>
            <p class="mt-1 text-xs text-gray-400">Summerar alla prenumerationer</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center md:text-left">
            <p class="text-xs font-semibold text-gray-300">Kommande (14 dagar)</p>
            <p class="mt-2 text-xl font-bold text-white">@soon</p>
            <p class="mt-1 text-xs text-gray-400">Nästa betalning inom 2 veckor</p>
        </div>
    </div>
    
    <div class="mx-4 md:mx-0 rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold text-white">Översikt</p>
        </div>

        <div class="mt-4">
            @if (Model == null || !Model.Any())
            {
                <div class="rounded-xl border border-white/10 bg-black/20 p-6 text-center">
                    <p class="text-sm font-medium text-white">Inga prenumerationer än</p>
                    <p class="mt-1 text-sm text-gray-400">Lägg till din första för att se översikten här.</p>

                    <button id="add-sub" data-modal-target="sub-modal"
                            class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white
                                   transition hover:bg-emerald-500">
                        <span class="text-lg leading-none">+</span>
                        <span>Lägg till prenumeration</span>
                    </button>
                </div>
            }
            else
            {
                @await Html.PartialAsync("Partials/Components/Cards/_SubCard", Model)
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("Partials/Modals/_AddSubmodal")