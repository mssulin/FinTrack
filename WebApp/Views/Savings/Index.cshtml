@model IEnumerable<WebApp.ViewModels.SavingViewModel>

@{
    ViewData["Title"] = "Sparande";
}

<div class="main">
    <div class="main-content">
        <div class="header">
            <div class="button-group">
                <button id="add-save" class="btn header-button" data-modal-target="saving-goal-modal">
                    <span>Nytt sparmål</span>
                </button>
            </div>
        </div>

        <div id="savings-overview">
            @await Html.PartialAsync("Partials/Components/Cards/_SavingCard", Model)
        </div>
    </div>
</div>

@await Html.PartialAsync("Partials/Modals/_CreateSavingGoalModal")   