@model IEnumerable<WebApp.ViewModels.SavingViewModel>

@{
    ViewData["Title"] = "Sparande";

    var goals = Model?.ToList() ?? new List<WebApp.ViewModels.SavingViewModel>();
    var count = goals.Count;

    var totalSaved = goals.Sum(x => x.CurrentAmount);
}
    
    <div class="page-header">
        <div>
            <h1 class="page-title">Sparande</h1>
            <p class="page-description">
                Skapa sparmål och följ din utveckling över tid.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button id="add-save" data-modal-target="saving-goal-modal"
                    class="primary-action-btn">
                <span class="text-lg leading-none">+</span>
                <span>Nytt sparmål</span>
            </button>
        </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3 px-6 md:px-0">
        <div class="stats-card">
            <p class="stats-title">Antal sparmål</p>
            <p class="stats-value">@count</p>
        </div>

        <div class="stats-card">
            <p class="stats-title">Totalt sparat</p>
            <p class="stats-value">@totalSaved.ToString("N0") kr</p>
        </div>
    </div>
    
    <div class="section-overview">
        <div class="flex items-center justify-between gap-3">
            <p class="text-lg font-semibold text-white">Översikt</p>
        </div>

        <div class="mt-4">
            @if (Model == null || !Model.Any())
            {
                <div class="rounded-xl border border-white/10 bg-black/20 p-6 text-center">
                    <p class="text-sm font-medium text-white">Inga sparmål än</p>
                    <p class="mt-1 text-sm text-gray-400">Skapa ditt första sparmål för att se översikten här.</p>

                    <button data-modal-target="saving-goal-modal"
                            class="primary-action-btn">
                        <span class="text-lg leading-none">+</span>
                        <span>Nytt sparmål</span>
                    </button>
                </div>
            }
            else
            {
                @await Html.PartialAsync("Partials/Components/Cards/_SavingCard", Model)
            }
        </div>
    </div>

@await Html.PartialAsync("Partials/Modals/_CreateSavingGoalModal")